{
  "name": "magdv/roadrunner-symfony-bundle",
  "description": "Roadrunner runtime for Symfony",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Rostislav Kaleta",
      "email": "rostislavkaleta@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-sockets": "*",
    "nyholm/psr7": "^1.8",
    "roadrunner/roadrunner": "^3.0",
    "symfony/dependency-injection": "^7.1",
    "symfony/http-kernel": "^7.1",
    "symfony/psr-http-message-bridge": "^7.1",
    "symfony/runtime": "^7.1",
    "symfony/framework-bundle": "^7.1",
    "roadrunner/worker": "^3.8",
    "roadrunner/http": "^4.2",
    "roadrunner/cli": "^3.1",
    "roadrunner/jobs": "^4.9",
    "temporal/sdk": "^2.17"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "FluffyDiscord\\RoadRunnerBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FluffyDiscord\\RoadRunnerBundle\\Tests\\": "tests/"
    }
  },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-html var/test/coverage"
    },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true,
      "php-http/discovery": true
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.5",
    "rector/rector": "^0.15.7",
    "sentry/sentry-symfony": "^5",
    "phpunit/phpunit": "^10.5",
    "symfony/mime": "^7.1",
    "roadrunner-php/centrifugo": "^2.5",
    "roadrunner/kv": "^4.5"
  }
}
